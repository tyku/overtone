    "test:browser": "playwright test",
    "test:stack": "playwright test --config playwright.stack.config.ts",
    "test:image": "sh scripts/test-production-image.sh"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "marked": "^16.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "fake-indexeddb": "^6.2.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^4.1.11"
  }
}
