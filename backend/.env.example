NODE_ENV=development
SESSION_TTL_HOURS=12
TRUST_PROXY_HOPS=1

# Local development is explicitly unrestricted. In production use "allowlist"
# with VPN/office CIDRs, or "deny" until the network policy is configured.
ADMIN_NETWORK_MODE=unrestricted
ADMIN_ALLOWED_CIDRS=
PORT=3000
FFMPEG_PATH=ffmpeg
FFMPEG_TIMEOUT_MS=1800000
DATABASE_URL=postgresql://overtone:overtone_local@postgres:5432/overtone
# Dedicated medical-scribe role is provisioned by infrastructure.
MEDSCRIBE_DATABASE_URL=postgresql://medscribe:replace_me@postgres:5432/overtone
RECORDINGS_DIR=recordings
# Technical size/part limits, not a duration cap or the 30-second report SLO.
MAX_UPLOAD_BYTES=1073741824
MAX_AUDIO_PARTS=1000
HTTP_UPLOAD_TIMEOUT_MS=2100000
POSTGRES_USER=overtone
POSTGRES_PASSWORD=overtone_local
POSTGRES_DB=overtone

# S3-compatible storage. For backend running in Docker use http://minio:9000;
# for npm run start:dev on the host use http://localhost:9000.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=medical-scribe
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Local API / worker (Docker Compose overrides hosts for the worker).
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=redis_local
# Change when another local project already occupies 6379.
REDIS_HOST_PORT=6379
INFERENCE_GRPC_ADDRESS=localhost:50051
INFERENCE_GRPC_TLS=false
INFERENCE_LLM_BACKEND=LOCAL
INFERENCE_SPECIALTY=
# Set to the cloud URL in Swarm; local Compose needs the internal postgres host.
WORKER_DATABASE_URL=postgresql://overtone:overtone_local@postgres:5432/overtone
